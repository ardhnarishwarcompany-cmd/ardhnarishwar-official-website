
# Server
PORT=5000

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ardhnarishwar
DB_USER=root
DB_PASSWORD=

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin account (used only by the seed script)
SEED_ADMIN_EMAIL=admin@ardhnarishwar.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin

# Where uploaded images are served from
# Use a relative path (recommended) so images work on every domain.
# Only set an absolute URL if you serve uploads from a CDN.
UPLOADS_URL_BASE=/uploads

# Phase 1: central platform auth (organization users)
PLATFORM_JWT_SECRET=replace-with-a-different-long-random-string
PLATFORM_ACCESS_EXPIRES_IN=15m
PLATFORM_REFRESH_EXPIRES_DAYS=30

# Phase 4: candidate auth (job seekers) — separate secret again so the
# three token systems (admin / org platform / candidate) can never mix.
CANDIDATE_JWT_SECRET=replace-with-a-third-long-random-string
CANDIDATE_ACCESS_EXPIRES_IN=15m
CANDIDATE_REFRESH_EXPIRES_DAYS=30

# --- Outgoing email (OTP verification, password reset) -------------------
# Leave these blank and OTPs are only printed to this console (dev mode).
# Fill them in with any SMTP provider (Gmail App Password, SendGrid,
# Mailgun, Resend, AWS SES SMTP, Brevo, your company's mail server, etc.)
# and OTPs will actually be emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
